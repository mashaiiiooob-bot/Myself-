diff --git a/tests/test_purge.py b/tests/test_purge.py
new file mode 100644
index 0000000..8735202
--- /dev/null
+++ b/tests/test_purge.py
@@ -0,0 +1,140 @@
+"""Tests for 'حذف x پیام اخیر' (self_tools/purge.py)."""
+import asyncio
+import os
+import sys
+import types
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+from pyrogram.enums import ChatMemberStatus, ChatType
+from self_tools import purge, selfloop as sl
+
+purge.REPORT_TTL = 0
+CHAT = -100
+
+
+class FakeClient:
+    def __init__(self, top_id, status=ChatMemberStatus.ADMINISTRATOR, can_delete=True):
+        self.me = types.SimpleNamespace(id=7)
+        self.status, self.can_delete = status, can_delete
+        self.all_ids = list(range(1, top_id + 1))     # existing message ids
+        self.calls = []                                 # each delete_messages chunk
+        self.sent = []
+
+    async def get_chat_member(self, chat_id, who):
+        return types.SimpleNamespace(status=self.status,
+                                     privileges=types.SimpleNamespace(can_delete_messages=self.can_delete))
+
+    async def get_chat_history(self, chat_id, limit=0, offset_id=0):
+        older = [i for i in sorted(self.all_ids, reverse=True) if i < offset_id]
+        for i in older[:limit]:
+            yield types.SimpleNamespace(id=i)
+
+    async def delete_messages(self, chat_id, ids):
+        ids = [ids] if isinstance(ids, int) else list(ids)
+        self.calls.append(ids)
+        self.all_ids = [i for i in self.all_ids if i not in ids]
+        return len(ids)
+
+    async def send_message(self, chat_id, text):
+        r = types.SimpleNamespace(text=text, deleted=False)
+        async def d(): r.deleted = True
+        r.delete = d
+        self.sent.append(r)
+        return r
+
+
+def msg(client, text, cmd_id, ctype=ChatType.SUPERGROUP):
+    replies = []
+    async def reply_text(t):
+        r = types.SimpleNamespace(text=t, deleted=False)
+        async def d(): r.deleted = True
+        r.delete = d
+        replies.append(r)
+        return r
+    return types.SimpleNamespace(text=text, id=cmd_id, reply_text=reply_text, replies=replies,
+                                 chat=types.SimpleNamespace(id=CHAT, type=ctype))
+
+
+async def main():
+    # parser
+    assert purge._parse_count("حذف 20 پیام اخیر") == 20
+    assert purge._parse_count("حذف ۲۰ پیام اخیر") == 20
+    assert purge._parse_count("حذف ٣ پیام") == 3
+    assert purge._parse_count("/purge 5") == 5 and purge._parse_count(".purge 5") == 5
+    for bad in ("حذف پیام اخیر", "حذف x پیام اخیر", "سلام", "purge 5", "حذف 5 پیام اخیر لطفا"):
+        assert purge._parse_count(bad) is None, bad
+
+    # 1) happy path: top message id 50 is the command; delete the 10 before it + the command
+    c = FakeClient(top_id=50)
+    c.all_ids += [51, 52]                                # messages that arrived after the command
+    m = msg(c, "حذف 10 پیام اخیر", 50)
+    await purge.handler(c, m)
+    deleted = sorted(i for ch in c.calls for i in ch)
+    assert deleted == list(range(40, 51)), deleted      # 40..49 + command(50)
+    assert 51 in c.all_ids and 52 in c.all_ids           # newer messages untouched
+    assert c.calls[-1] == [50]                           # command deleted last
+    await asyncio.sleep(0); await asyncio.sleep(0)
+    assert c.sent and "10 پیام حذف شد" in c.sent[0].text and c.sent[0].deleted
+
+    # 2) more than 100 -> batched (250 = 100+100+50), nothing else touched
+    c = FakeClient(top_id=400)
+    await purge.handler(c, msg(c, "/purge 250", 400))
+    sizes = [len(x) for x in c.calls]
+    assert sizes[:3] == [100, 100, 50] and sum(sizes) == 251, sizes
+    assert min(i for ch in c.calls for i in ch) == 150
+
+    # 3) fewer messages than requested in the chat
+    c = FakeClient(top_id=6)
+    await purge.handler(c, msg(c, "حذف 100 پیام اخیر", 6))
+    assert sorted(i for ch in c.calls for i in ch) == [1, 2, 3, 4, 5, 6]
+
+    # 4) cap
+    c = FakeClient(top_id=50)
+    m = msg(c, "حذف 100000 پیام اخیر", 50)
+    await purge.handler(c, m)
+    assert c.calls == [] and "بین ۱ تا" in m.replies[0].text
+    m = msg(c, "حذف 0 پیام اخیر", 50); await purge.handler(c, m); assert c.calls == []
+
+    # 5) private chat / no right / plain member -> nothing deleted
+    for ctype, kw in ((ChatType.PRIVATE, {}), (ChatType.CHANNEL, {}),
+                      (ChatType.SUPERGROUP, {"can_delete": False}),
+                      (ChatType.SUPERGROUP, {"status": ChatMemberStatus.MEMBER})):
+        c = FakeClient(top_id=30, **kw)
+        m = msg(c, "حذف 5 پیام اخیر", 30, ctype)
+        await purge.handler(c, m)
+        assert c.calls == [], (ctype, kw)
+        assert m.replies, "user should be told why"
+
+    # 6) owner works
+    c = FakeClient(top_id=20, status=ChatMemberStatus.OWNER, can_delete=False)
+    await purge.handler(c, msg(c, "حذف 3 پیام اخیر", 20))
+    assert sorted(i for ch in c.calls for i in ch) == [17, 18, 19, 20]
+
+    # 7) concurrent run in same chat is rejected
+    c = FakeClient(top_id=50)
+    purge._RUNNING.add((7, CHAT))
+    m = msg(c, "حذف 5 پیام اخیر", 50); await purge.handler(c, m)
+    assert c.calls == [] and "در حال انجام" in m.replies[0].text
+    purge._RUNNING.clear()
+
+    # 8) partial failure is reported
+    c = FakeClient(top_id=30)
+    orig = c.delete_messages
+    async def partial(chat_id, ids):
+        ids = [ids] if isinstance(ids, int) else list(ids)
+        return len(ids) - 2 if len(ids) > 5 else await orig(chat_id, ids)
+    c.delete_messages = partial
+    await purge.handler(c, msg(c, "حذف 10 پیام اخیر", 30))
+    await asyncio.sleep(0)
+    assert "حذف نشد" in c.sent[0].text
+
+    # 9) registration + not-a-purge text ignored
+    class Reg:
+        def __init__(self): self.h = []
+        def add_handler(self, h, group=0): self.h.append(h)
+    r = Reg(); purge.register(r); assert len(r.h) == 1
+    c = FakeClient(top_id=10)
+    await purge.handler(c, msg(c, "حذف همه", 10)); assert c.calls == []
+    print("purge: OK (9 groups of checks)")
+
+asyncio.run(main())
diff --git a/tests/test_selfloop_autodelete.py b/tests/test_selfloop_autodelete.py
